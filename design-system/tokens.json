{
  "$comment": "Brand tokens for both sites. Palette hex values come from the owner's 2026 palette sheets (brand/<site>/color-palette.jpg). 'derived' values are tints/shades added only for accessible text and soft backgrounds; see docs/consistency-review.md. These map 1:1 to theme.json settings.color.palette in the WordPress child themes.",
  "shared": {
    "radius": "18px",
    "radiusSmall": "10px",
    "containerWidth": "1160px",
    "accentFont": "Playfair Display (italic, taglines only)"
  },
  "life-solutions": {
    "domain": "https://transformativelifesolutions.com",
    "fonts": { "heading": "Lora", "body": "Open Sans", "accent": "Playfair Display" },
    "palette": {
      "dark-teal-blue":  { "hex": "#006B7B", "source": "palette", "use": "primary buttons, links, eyebrows" },
      "deep-navy-teal":  { "hex": "#003853", "source": "palette", "use": "headings, footer, hover" },
      "soft-grey-blue":  { "hex": "#8BABB1", "source": "palette", "use": "decorative only (fails text contrast)" },
      "warm-teal-grey":  { "hex": "#A0B7B9", "source": "palette", "use": "decorative only (fails text contrast)" },
      "silver-grey":     { "hex": "#C1C7CE", "source": "palette", "use": "borders/dividers only" },
      "warm-gold":       { "hex": "#D4AF37", "source": "palette", "use": "accent lines and icons only, never text" },
      "soft-teal-tint":  { "hex": "#E8F0F1", "source": "derived", "use": "soft section background" },
      "mist":            { "hex": "#F4F7F8", "source": "derived", "use": "page hero / alternate background" },
      "line":            { "hex": "#D5E0E2", "source": "derived", "use": "card borders" },
      "ink":             { "hex": "#1C2B33", "source": "derived", "use": "body text" },
      "muted-ink":       { "hex": "#46585F", "source": "derived", "use": "secondary text" }
    }
  },
  "leadership-systems": {
    "domain": "https://transformativeleadershipsystems.com",
    "fonts": { "heading": "Merriweather", "body": "Lato", "accent": "Playfair Display" },
    "palette": {
      "deep-leadership-blue":       { "hex": "#0F2040", "source": "palette", "use": "primary buttons, headings, footer" },
      "growth-teal-green":          { "hex": "#2B4E47", "source": "palette", "use": "hover, links on light backgrounds" },
      "transformative-green-grey":  { "hex": "#6D8271", "source": "palette", "use": "icons, large text only" },
      "systems-light-blue-grey":    { "hex": "#8CB5C2", "source": "palette", "use": "decorative only (fails text contrast)" },
      "leadership-ocher-yellow":    { "hex": "#C89B5F", "source": "palette", "use": "accent lines only, never text" },
      "neutral-grey-text":          { "hex": "#7A7A7A", "source": "palette", "use": "large/secondary text on white only" },
      "base-off-white-canvas":      { "hex": "#F8F8F8", "source": "palette", "use": "page and section background" },
      "blue-grey-tint":             { "hex": "#EAF1F3", "source": "derived", "use": "soft section background" },
      "line":                       { "hex": "#DDE3E3", "source": "derived", "use": "card borders" },
      "ink":                        { "hex": "#1A2233", "source": "derived", "use": "body text" },
      "muted-ink":                  { "hex": "#51595C", "source": "derived", "use": "secondary body text (darkened neutral grey for AA)" }
    }
  }
}
